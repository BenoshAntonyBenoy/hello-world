{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "helloworld-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8010"],
      "port": 8010,
      "url": "http://localhost:8010"
    },
    {
      "name": "helloworld-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5190", "--strictPort"],
      "port": 5190
    }
  ]
}
