# ---------------------------------------------------------------------------
# hello-world backend configuration
# Copy to .env and adjust. Every value below has a working default.
# ---------------------------------------------------------------------------

# Database.
# Default is a local SQLite file so the project runs with zero setup.
# For the production target, point this at PostgreSQL and install psycopg:
#   DATABASE_URL=postgresql+psycopg://helloworld:helloworld@localhost:5432/helloworld
DATABASE_URL=sqlite:///./helloworld.db

# CORS origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,http://localhost:5173

# Which job data connectors to enable at ingestion time (comma-separated).
# See app/connectors/registry.py for the available identifiers.
ENABLED_CONNECTORS=mock_dataset

# Seed corpus size per role. Higher = slower seeding, smoother statistics.
SEED_POSTINGS_PER_ROLE=180

# Deterministic seed so the generated corpus is reproducible across machines.
SEED_RANDOM_STATE=20260811

# Months of synthetic posting history to generate for trend analysis.
SEED_HISTORY_MONTHS=12

# --- Optional LLM-assisted extraction -------------------------------------
# The extraction pipeline is deterministic and rule-based by default.
# Setting a key enables the optional LLM pass for unmatched requirement
# phrases (see app/extraction/llm.py). Leave blank to stay fully offline.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_EXTRACTION_ENABLED=false

# Minimum number of postings before a statistic is reported as high confidence.
CONFIDENCE_HIGH_MIN_POSTINGS=150
CONFIDENCE_MEDIUM_MIN_POSTINGS=40
